{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/delivery-sms.js": { "maxDuration": 60, "includeFiles": "{server,src/lib}/**" },
    "api/gps-address.js": { "maxDuration": 30, "includeFiles": "{server,src/lib}/**" },
    "api/admin-otp.js": { "maxDuration": 60, "includeFiles": "{server,src/lib}/**" }
  },
  "rewrites": [{ "source": "/admin/:path*", "destination": "/index.html" }, { "source": "/review", "destination": "/index.html" }]
}
