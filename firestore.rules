      allow read: if active() && (resource.data.ownerId == request.auth.uid || resource.data.email == request.auth.token.email.lower() || isAdmin());
      allow create: if inviteId.matches('^' + request.auth.uid + '_[a-f0-9]{64}$') && validStoreInvite(request.resource.data) && inviteOwner(request.resource.data) && request.resource.data.status == 'pending' && request.resource.data.memberId == '' && request.resource.data.createdAt == request.time && request.resource.data.storeName == get(/databases/$(database)/documents/stores/$(request.resource.data.storeId)).data.name;
