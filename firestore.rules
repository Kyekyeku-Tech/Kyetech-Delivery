        (inviteOwner(resource.data) && ((request.resource.data.status == 'revoked' && request.resource.data.memberId == resource.data.memberId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])) || (resource.data.status == 'revoked' && request.resource.data.status == 'pending' && request.resource.data.memberId == '' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','memberId','storeName','updatedAt'])))) ||
        (verifiedInvitee(resource.data) && resource.data.status == 'pending' && request.resource.data.status == 'accepted' && request.resource.data.memberId == request.auth.uid && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','memberId','updatedAt']) && getAfter(/databases/$(database)/documents/storeMembers/$(resource.data.storeId + '_' + request.auth.uid)).data.inviteId == inviteId && getAfter(/databases/$(database)/documents/storeMembers/$(resource.data.storeId + '_' + request.auth.uid)).data.enabled == true)
