rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function self(uid) { return signedIn() && request.auth.uid == uid; }
    function enabledAdmin() { return active() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)) && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true; }
    function validAdminOtpClaim() {
      return signedIn() && request.auth.token.get('adminOtpSessionId','') is string && request.auth.token.get('adminOtpSessionId','').matches('^[a-f0-9]{64}$') && request.auth.token.get('firebase',{}).get('sign_in_provider','') == 'custom';
    }
    function activeAdminOtpSession() {
      let sid = request.auth.token.adminOtpSessionId;
      let session = get(/databases/$(database)/documents/adminOtpSessions/$(sid)).data;
      return exists(/databases/$(database)/documents/adminOtpSessions/$(sid)) && session.uid == request.auth.uid && session.status == 'active' && session.authTime is int && request.auth.token.get('auth_time',null) is int && session.authTime == request.auth.token.auth_time && session.expiresAt is timestamp && session.expiresAt > request.time;
    }
    function isAdmin() { return enabledAdmin() && validAdminOtpClaim() && activeAdminOtpSession(); }
    function currentUser() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return signedIn() && currentUser().get('accountStatus','active') == 'active'; }
    function hasRole(value) { return active() && currentUser().role == value; }
    function storeMember(storeId) { return active() && exists(/databases/$(database)/documents/storeMembers/$(storeId + '_' + request.auth.uid)) && get(/databases/$(database)/documents/storeMembers/$(storeId + '_' + request.auth.uid)).data.enabled == true && get(/databases/$(database)/documents/storeInvites/$(get(/databases/$(database)/documents/storeMembers/$(storeId + '_' + request.auth.uid)).data.inviteId)).data.status == 'accepted' && get(/databases/$(database)/documents/users/$(storeId)).data.get('accountStatus','active') == 'active'; }
    function approvedRider() { return hasRole('rider') && currentUser().get('approvalStatus','pending') == 'approved'; }
    function text(value, limit) { return value is string && value.size() > 0 && value.size() <= limit; }
    function optionalText(value, limit) { return value is string && value.size() <= limit; }
    function phone(value) { return value is string && value.matches('^\\+233[235][0-9]{8}$'); }
    function image(value) { return value is string && value.size() <= 2000 && (value == '' || value.matches('^https?://[^\\s]+$') || value.matches('^/images/[A-Za-z0-9_-]+\\.[A-Za-z0-9]+$')); }
    function validModeration(d) {
      return d.get('accountStatus','active') in ['active','suspended'] && d.get('approvalStatus','pending') in ['pending','approved','rejected','suspended'] && optionalText(d.get('reviewNote',''),1000) && optionalText(d.get('reviewedBy',''),128) && (d.get('reviewedAt',null) == null || d.reviewedAt is timestamp);
    }
    function initialModeration(d, approval) { return d.accountStatus == 'active' && d.approvalStatus == approval && d.reviewNote == '' && d.reviewedBy == '' && d.reviewedAt == null; }
    function unchangedModeration(old, next, approval) {
      return next.get('accountStatus','active') == old.get('accountStatus','active') && next.get('approvalStatus',approval) == old.get('approvalStatus',approval) && next.get('reviewNote','') == old.get('reviewNote','') && next.get('reviewedBy','') == old.get('reviewedBy','') && next.get('reviewedAt',null) == old.get('reviewedAt',null);
    }
    function validProfile(d) {
      return d.keys().hasAll(['name','email','phone','role','city','photoUrl','bikeBrand','bikeModel','plate','online','createdAt','updatedAt']) && d.keys().hasOnly(['name','email','phone','role','city','photoUrl','bikeBrand','bikeModel','plate','online','createdAt','updatedAt','accountStatus','approvalStatus','reviewNote','reviewedBy','reviewedAt']) && text(d.name,100) && text(d.email,254) && phone(d.phone) && d.role in ['customer','rider','merchant'] && text(d.city,100) && image(d.photoUrl) && optionalText(d.bikeBrand,40) && optionalText(d.bikeModel,100) && optionalText(d.plate,40) && d.online is bool && d.createdAt is timestamp && d.updatedAt == request.time && validModeration(d) && (d.role == 'rider' || (d.online == false && d.bikeBrand == '' && d.bikeModel == '' && d.plate == '')) && (d.online == false || (d.get('accountStatus','active') == 'active' && d.get('approvalStatus','pending') == 'approved' && d.bikeBrand in ['Apsonic','Royal','Boxer','Other'] && text(d.bikeModel,100) && text(d.plate,40)));
    }
    function riderMatchesUser(r,u) {
      return r.keys().hasAll(['name','phone','city','photoUrl','bikeBrand','bikeModel','plate','online','updatedAt']) && r.keys().hasOnly(['name','phone','city','photoUrl','bikeBrand','bikeModel','plate','online','updatedAt','accountStatus','approvalStatus','reviewNote','reviewedBy','reviewedAt']) && r.name == u.name && r.phone == u.phone && r.city == u.city && r.photoUrl == u.photoUrl && r.bikeBrand == u.bikeBrand && r.bikeModel == u.bikeModel && r.plate == u.plate && r.online == u.online && r.updatedAt == request.time && unchangedModeration(u,r,'pending');
    }
    function profileMirror(uid,d) { return d.role != 'rider' || riderMatchesUser(getAfter(/databases/$(database)/documents/riders/$(uid)).data,d); }
    function adminReview(old,next) {
      return isAdmin() && next.reviewedBy == request.auth.uid && next.reviewedAt == request.time && next.updatedAt == request.time && next.diff(old).affectedKeys().hasOnly(['accountStatus','approvalStatus','reviewNote','reviewedBy','reviewedAt','online','updatedAt']) && validModeration(next);
    }
    match /admins/{uid} {
      allow get: if self(uid) || isAdmin();
      allow list: if isAdmin();
      allow create, update: if isAdmin() && uid != request.auth.uid && exists(/databases/$(database)/documents/users/$(uid)) && request.resource.data.keys().hasAll(['enabled','updatedBy','updatedAt']) && request.resource.data.keys().hasOnly(['enabled','updatedBy','updatedAt']) && request.resource.data.enabled is bool && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /adminOtpSessions/{sid} {
      // Only the server grants access; this read lets the signed-in session show its gate state.
      allow get: if enabledAdmin() && validAdminOtpClaim() && sid == request.auth.token.adminOtpSessionId && (!exists(/databases/$(database)/documents/adminOtpSessions/$(sid)) || resource.data.uid == request.auth.uid);
      allow list, create, update, delete: if false;
    }
    match /adminOtpChallenges/{challengeId} { allow read, write: if false; }
    match /adminOtpThrottle/{throttleId} { allow read, write: if false; }
    match /adminOtpCooldowns/{cooldownId} { allow read, write: if false; }
    match /users/{uid} {
      allow get: if self(uid) || isAdmin();
      allow list: if isAdmin();
      allow create: if self(uid) && validProfile(request.resource.data) && request.resource.data.email == request.auth.token.email && request.resource.data.createdAt == request.time && initialModeration(request.resource.data, request.resource.data.role == 'rider' ? 'pending' : 'approved') && profileMirror(uid,request.resource.data);
      allow update: if validProfile(request.resource.data) && profileMirror(uid,request.resource.data) && ((self(uid) && active() && unchangedModeration(resource.data,request.resource.data,resource.data.role == 'rider' ? 'pending' : 'approved') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','city','photoUrl','bikeBrand','bikeModel','plate','online','updatedAt','accountStatus','approvalStatus','reviewNote','reviewedBy','reviewedAt'])) || adminReview(resource.data,request.resource.data) || (isAdmin() && unchangedModeration(resource.data,request.resource.data,resource.data.role == 'rider' ? 'pending' : 'approved') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','phone','city','photoUrl','bikeBrand','bikeModel','plate','online','updatedAt','accountStatus','approvalStatus','reviewNote','reviewedBy','reviewedAt'])));
      allow delete: if false;
    }
    match /riders/{uid} {
      allow read: if self(uid) || isAdmin() || (active() && resource.data.approvalStatus == 'approved' && resource.data.accountStatus == 'active');
      allow create, update: if (isAdmin() || (self(uid) && active())) && getAfter(/databases/$(database)/documents/users/$(uid)).data.role == 'rider' && riderMatchesUser(request.resource.data,getAfter(/databases/$(database)/documents/users/$(uid)).data);
      allow delete: if false;
    }
    function validLocation(value) {
      return value == null || (value is map && value.keys().hasAll(['latitude','longitude']) && value.keys().hasOnly(['latitude','longitude']) && value.latitude is number && value.longitude is number && value.latitude >= -90 && value.latitude <= 90 && value.longitude >= -180 && value.longitude <= 180);
    }
    function validOrderPickup(d) {
      let location = d.get('pickupLocation',null);
      return validLocation(location) && (d.merchantId == '' ? location == null : (!('pickupLocation' in d) || location == get(/databases/$(database)/documents/stores/$(d.merchantId)).data.get('location',null)));
    }
    function merchantDeliveryManager(storeId) { return hasRole('merchant') && (self(storeId) || storeMember(storeId)); }
    function merchantOrderManager(d) { return d.creatorRole == 'merchant' && d.creatorId == d.merchantId && merchantDeliveryManager(d.merchantId); }
    function validOrderSender(d) {
      return d.get('createdBy',d.creatorId) == request.auth.uid && text(d.customerName,100) && phone(d.customerPhone) && ((d.creatorRole == 'customer' && d.creatorId == request.auth.uid && d.customerName == currentUser().name && d.customerPhone == currentUser().phone) || (d.creatorRole == 'merchant' && d.creatorId == d.merchantId && merchantDeliveryManager(d.merchantId) && ((!('createdBy' in d) && self(d.creatorId) && d.customerName == currentUser().name && d.customerPhone == currentUser().phone) || ('createdBy' in d && d.customerName == get(/databases/$(database)/documents/stores/$(d.merchantId)).data.name && d.customerPhone == get(/databases/$(database)/documents/stores/$(d.merchantId)).data.phone))));
    }
    function validStore(d) {
      return d.keys().hasAll(['ownerId','name','category','address','phone','imageUrl','description','open','createdAt','updatedAt']) && d.keys().hasOnly(['ownerId','name','category','address','location','gpsAddress','phone','imageUrl','description','open','createdAt','updatedAt','accountStatus','approvalStatus','reviewNote','reviewedBy','reviewedAt']) && text(d.name,100) && text(d.category,60) && text(d.address,250) && phone(d.phone) && image(d.imageUrl) && optionalText(d.description,1000) && d.open is bool && d.createdAt is timestamp && d.updatedAt == request.time && validLocation(d.get('location',null)) && optionalText(d.get('gpsAddress',''),250) && (d.get('location',null) != null || d.get('gpsAddress','') == '') && validModeration(d);
    }
    match /stores/{uid} {
      allow read: if self(uid) || isAdmin() || (active() && resource.data.accountStatus == 'active' && (resource.data.approvalStatus == 'approved' || storeMember(uid)));
      allow create: if self(uid) && hasRole('merchant') && validStore(request.resource.data) && request.resource.data.ownerId == uid && request.resource.data.createdAt == request.time && initialModeration(request.resource.data,'pending');
      allow update: if validStore(request.resource.data) && request.resource.data.ownerId == resource.data.ownerId && request.resource.data.createdAt == resource.data.createdAt && ((self(uid) && hasRole('merchant') && unchangedModeration(resource.data,request.resource.data,'pending') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','category','address','location','gpsAddress','phone','imageUrl','description','open','updatedAt','accountStatus','approvalStatus','reviewNote','reviewedBy','reviewedAt'])) || adminReview(resource.data,request.resource.data) || (isAdmin() && unchangedModeration(resource.data,request.resource.data,'pending') && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name','category','address','location','gpsAddress','phone','imageUrl','description','open','updatedAt','accountStatus','approvalStatus','reviewNote','reviewedBy','reviewedAt'])));
      allow delete: if false;
    }
    function listingStore(storeId) { return get(/databases/$(database)/documents/stores/$(storeId)).data; }
    function listingOwner(storeId) {
      return hasRole('merchant') && self(storeId) && listingStore(storeId).ownerId == request.auth.uid && listingStore(storeId).get('accountStatus','active') == 'active';
    }
    function listingTeam(storeId) {
      return hasRole('merchant') && listingStore(storeId).get('accountStatus','active') == 'active' && storeMember(storeId);
    }
    function publicListingStore(storeId) {
      let store = listingStore(storeId);
      return active() && store.approvalStatus == 'approved' && store.get('accountStatus','active') == 'active' && get(/databases/$(database)/documents/users/$(store.ownerId)).data.get('accountStatus','active') == 'active';
    }
    function validStoreListing(d) {
      return d.keys().hasAll(['kind','name','category','description','price','imageUrl','available','createdAt','updatedAt']) && d.keys().hasOnly(['kind','name','category','description','price','imageUrl','available','createdAt','updatedAt']) && d.kind in ['product','menu'] && text(d.name,100) && text(d.category,60) && optionalText(d.description,1000) && d.price is number && d.price >= 0 && d.price <= 100000 && math.abs(d.price * 100 - math.floor(d.price * 100 + 0.5)) < 0.000001 && image(d.imageUrl) && d.available is bool && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    match /stores/{storeId}/listings/{listingId} {
      allow read: if listingOwner(storeId) || listingTeam(storeId) || (publicListingStore(storeId) && resource.data.available == true);
      allow create: if (listingOwner(storeId) || listingTeam(storeId)) && validStoreListing(request.resource.data) && request.resource.data.createdAt == request.time;
      allow update: if (listingOwner(storeId) || listingTeam(storeId)) && validStoreListing(request.resource.data) && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if listingOwner(storeId) || listingTeam(storeId);
    }
    function validNewOrder(d) {
      return d.keys().hasAll(['creatorId','creatorRole','customerName','customerPhone','pickup','dropoff','recipientName','recipientPhone','packageDescription','fee','preferredRiderId','merchantId','status','riderId','riderName','customerRating','riderRating','customerRatingComment','riderRatingComment','customerRatedAt','riderRatedAt','assignedAt','pickedUpAt','deliveredAt','createdAt','updatedAt']) && d.keys().hasOnly(['creatorId','createdBy','creatorRole','customerName','customerPhone','pickup','pickupLocation','dropoff','dropoffLocation','recipientName','recipientPhone','packageDescription','fee','preferredRiderId','merchantId','status','riderId','riderName','customerRating','riderRating','customerRatingComment','riderRatingComment','customerRatedAt','riderRatedAt','assignedAt','pickedUpAt','deliveredAt','createdAt','updatedAt']) && validOrderPickup(d) && validLocation(d.get('dropoffLocation',null)) && d.creatorRole == currentUser().role && d.creatorRole in ['customer','merchant'] && validOrderSender(d) && text(d.pickup,250) && text(d.dropoff,250) && text(d.recipientName,100) && phone(d.recipientPhone) && text(d.packageDescription,1000) && d.fee is number && d.fee >= 15 && d.fee <= 10000 && math.abs(d.fee * 100 - math.floor(d.fee * 100 + 0.5)) < 0.000001 && optionalText(d.preferredRiderId,128) && optionalText(d.merchantId,128) && (d.preferredRiderId == '' || (get(/databases/$(database)/documents/riders/$(d.preferredRiderId)).data.approvalStatus == 'approved' && get(/databases/$(database)/documents/riders/$(d.preferredRiderId)).data.accountStatus == 'active' && get(/databases/$(database)/documents/riders/$(d.preferredRiderId)).data.online == true)) && (d.merchantId == '' || (get(/databases/$(database)/documents/stores/$(d.merchantId)).data.approvalStatus == 'approved' && get(/databases/$(database)/documents/stores/$(d.merchantId)).data.accountStatus == 'active')) && (d.creatorRole != 'merchant' || d.merchantId == d.creatorId) && d.status == 'pending' && d.riderId == null && d.riderName == '' && d.customerRating == null && d.riderRating == null && d.customerRatingComment == '' && d.riderRatingComment == '' && d.customerRatedAt == null && d.riderRatedAt == null && d.assignedAt == null && d.pickedUpAt == null && d.deliveredAt == null && d.createdAt == request.time && d.updatedAt == request.time;
    }
    function claimingOrder() {
      let old = resource.data; let next = request.resource.data;
      return approvedRider() && currentUser().online == true && old.status == 'pending' && old.riderId == null && (old.preferredRiderId == '' || old.preferredRiderId == request.auth.uid) && next.diff(old).affectedKeys().hasOnly(['status','riderId','riderName','assignedAt','updatedAt']) && next.status == 'accepted' && next.riderId == request.auth.uid && next.riderName == currentUser().name && next.assignedAt == request.time && next.updatedAt == request.time;
    }
    function advancingOrder() {
      let old = resource.data; let next = request.resource.data;
      return approvedRider() && old.riderId == request.auth.uid && next.updatedAt == request.time && ((old.status == 'accepted' && next.status == 'picked_up' && next.pickedUpAt == request.time && next.diff(old).affectedKeys().hasOnly(['status','pickedUpAt','updatedAt'])) || (old.status == 'picked_up' && next.status == 'delivered' && next.deliveredAt == request.time && next.diff(old).affectedKeys().hasOnly(['status','deliveredAt','updatedAt'])));
    }
    function cancellingOrder() {
      let old = resource.data; let next = request.resource.data;
      return (old.creatorId == request.auth.uid || merchantOrderManager(old)) && old.status == 'pending' && next.status == 'cancelled' && next.updatedAt == request.time && next.diff(old).affectedKeys().hasOnly(['status','updatedAt']);
    }
    function ratingOrder() {
      let old = resource.data; let next = request.resource.data;
      return old.status == 'delivered' && next.updatedAt == request.time && (((old.creatorId == request.auth.uid || merchantOrderManager(old)) && old.customerRating == null && next.customerRating is int && next.customerRating >= 1 && next.customerRating <= 5 && optionalText(next.customerRatingComment,1000) && next.customerRatedAt == request.time && next.diff(old).affectedKeys().hasOnly(['customerRating','customerRatingComment','customerRatedAt','updatedAt'])) || (old.riderId == request.auth.uid && old.riderRating == null && next.riderRating is int && next.riderRating >= 1 && next.riderRating <= 5 && optionalText(next.riderRatingComment,1000) && next.riderRatedAt == request.time && next.diff(old).affectedKeys().hasOnly(['riderRating','riderRatingComment','riderRatedAt','updatedAt'])));
    }
    function adminOrderUpdate() {
      let old = resource.data; let next = request.resource.data;
      return isAdmin() && next.updatedAt == request.time && (
        (old.status in ['pending','accepted'] && next.status == 'accepted' && next.diff(old).affectedKeys().hasOnly(['status','riderId','riderName','assignedAt','updatedAt']) && text(next.riderId,128) && get(/databases/$(database)/documents/users/$(next.riderId)).data.role == 'rider' && get(/databases/$(database)/documents/users/$(next.riderId)).data.approvalStatus == 'approved' && get(/databases/$(database)/documents/users/$(next.riderId)).data.accountStatus == 'active' && get(/databases/$(database)/documents/users/$(next.riderId)).data.online == true && next.riderName == get(/databases/$(database)/documents/users/$(next.riderId)).data.name && next.assignedAt == request.time) ||
        (old.status in ['pending','accepted','picked_up'] && next.status == 'cancelled' && next.diff(old).affectedKeys().hasOnly(['status','updatedAt'])) ||
        (old.status == 'accepted' && next.status == 'picked_up' && next.pickedUpAt == request.time && next.diff(old).affectedKeys().hasOnly(['status','pickedUpAt','updatedAt'])) ||
        (old.status == 'picked_up' && next.status == 'delivered' && next.deliveredAt == request.time && next.diff(old).affectedKeys().hasOnly(['status','deliveredAt','updatedAt']))
      );
    }
    match /orders/{orderId} {
      allow read: if isAdmin() || (active() && (resource.data.creatorId == request.auth.uid || (resource.data.creatorRole == 'merchant' && resource.data.merchantId == resource.data.creatorId && storeMember(resource.data.creatorId)) || (currentUser().role == 'rider' && (resource.data.riderId == request.auth.uid || (approvedRider() && resource.data.status == 'pending')))));
      allow create: if active() && validNewOrder(request.resource.data);
