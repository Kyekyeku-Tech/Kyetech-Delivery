      allow delete: if trackingId == 'rider' && (isAdmin() || (hasRole('rider') && (exists(/databases/$(database)/documents/orders/$(orderId)/tracking/$(trackingId)) ? resource.data.riderId == request.auth.uid : trackedOrder(orderId).riderId == request.auth.uid)));
    }
    function validStoreInvite(d) {
      return d.keys().hasAll(['ownerId','storeId','storeName','email','status','memberId','createdAt','updatedAt']) && d.keys().hasOnly(['ownerId','storeId','storeName','email','status','memberId','createdAt','updatedAt']) && text(d.ownerId,128) && d.storeId == d.ownerId && text(d.storeName,100) && text(d.email,254) && d.email == d.email.lower() && d.status in ['pending','accepted','revoked'] && optionalText(d.memberId,128) && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function inviteOwner(d) { return hasRole('merchant') && d.ownerId == request.auth.uid && get(/databases/$(database)/documents/stores/$(d.storeId)).data.ownerId == request.auth.uid; }
    function verifiedInvitee(d) { return hasRole('merchant') && request.auth.token.get('email_verified',false) == true && d.email == request.auth.token.email.lower(); }
    match /storeInvites/{inviteId} {
