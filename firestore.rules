      allow delete: if false;
    }
    function validStoreMember(d) {
      return d.keys().hasAll(['storeId','userId','email','name','inviteId','enabled','createdAt','updatedAt']) && d.keys().hasOnly(['storeId','userId','email','name','inviteId','enabled','createdAt','updatedAt']) && text(d.storeId,128) && text(d.userId,128) && text(d.email,254) && text(d.name,100) && text(d.inviteId,256) && d.enabled is bool && d.createdAt is timestamp && d.updatedAt == request.time;
    }
    function acceptingMembership(d) {
      let before = get(/databases/$(database)/documents/storeInvites/$(d.inviteId)).data;
      let after = getAfter(/databases/$(database)/documents/storeInvites/$(d.inviteId)).data;
      return verifiedInvitee(before) && before.status == 'pending' && after.status == 'accepted' && after.memberId == request.auth.uid && before.storeId == d.storeId && d.userId == request.auth.uid && d.email == before.email && d.name == currentUser().name && d.enabled == true;
    }
    match /storeMembers/{memberId} {
      allow get: if hasRole('merchant') && memberId.matches('^[A-Za-z0-9_-]+_' + request.auth.uid + '$');
      allow read: if active() && (resource.data.userId == request.auth.uid || resource.data.storeId == request.auth.uid || isAdmin());
      allow create: if validStoreMember(request.resource.data) && memberId == request.resource.data.storeId + '_' + request.auth.uid && request.resource.data.createdAt == request.time && acceptingMembership(request.resource.data);
      allow update: if validStoreMember(request.resource.data) && request.resource.data.storeId == resource.data.storeId && request.resource.data.userId == resource.data.userId && request.resource.data.createdAt == resource.data.createdAt && ((hasRole('merchant') && resource.data.storeId == request.auth.uid && request.resource.data.enabled == false && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['enabled','updatedAt'])) || (memberId == request.resource.data.storeId + '_' + request.auth.uid && acceptingMembership(request.resource.data)));
      allow delete: if false;
    }
    match /feedback/{feedbackId} {
      allow read: if isAdmin() || (active() && resource.data.ownerId == request.auth.uid);
      allow create: if active() && request.resource.data.keys().hasAll(['ownerId','role','name','message','createdAt','status','adminNote','reviewedBy','reviewedAt']) && request.resource.data.keys().hasOnly(['ownerId','role','name','message','createdAt','status','adminNote','reviewedBy','reviewedAt']) && request.resource.data.ownerId == request.auth.uid && request.resource.data.role == currentUser().role && request.resource.data.name == currentUser().name && text(request.resource.data.message,2000) && request.resource.data.createdAt == request.time && request.resource.data.status == 'open' && request.resource.data.adminNote == '' && request.resource.data.reviewedBy == '' && request.resource.data.reviewedAt == null;
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','adminNote','reviewedBy','reviewedAt']) && request.resource.data.status in ['open','in_review','resolved'] && optionalText(request.resource.data.adminNote,2000) && request.resource.data.reviewedBy == request.auth.uid && request.resource.data.reviewedAt == request.time;
      allow delete: if false;
    }
    match /adminAudit/{auditId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasAll(['actorId','action','targetType','targetId','note','createdAt']) && request.resource.data.keys().hasOnly(['actorId','action','targetType','targetId','note','createdAt']) && request.resource.data.actorId == request.auth.uid && text(request.resource.data.action,80) && request.resource.data.targetType in ['user','rider','store','order','feedback','admin'] && text(request.resource.data.targetId,128) && optionalText(request.resource.data.note,2000) && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    function smsActor(d) {
      let order = get(/databases/$(database)/documents/orders/$(d.orderId)).data;
      return isAdmin() || (approvedRider() && order.riderId == request.auth.uid);
    }
    function smsCustomer(d) { return hasRole('customer') && d.get('customerId','') == request.auth.uid && d.status == 'submitted'; }
    function smsMerchant(d) {
      let storeId = d.get('merchantId','');
      return hasRole('merchant') && storeId != '' && d.status == 'submitted' && (self(storeId) || storeMember(storeId));
    }
    function smsAudienceMatchesOrder(d) {
      let order = get(/databases/$(database)/documents/orders/$(d.orderId)).data;
      return order.status == d.type && ((order.creatorRole == 'customer' && d.customerId == order.creatorId && d.get('merchantId','') == '') || (order.creatorRole == 'merchant' && order.merchantId == order.creatorId && d.customerId == '' && d.get('merchantId','') == order.creatorId));
    }
    function smsReviewLink(d) {
      let token = d.get('recipientReviewToken','');
      return token == '' || (token is string && token.matches('^[a-f0-9]{48}$') && d.type == 'delivered' && d.get('merchantId','') != '' && getAfter(/databases/$(database)/documents/deliveryReviewLinks/$(token)).data.orderId == d.orderId && getAfter(/databases/$(database)/documents/deliveryReviewLinks/$(token)).data.merchantId == d.merchantId && getAfter(/databases/$(database)/documents/deliveryReviewLinks/$(token)).data.createdAt == request.time);
    }
    function validDeliveryReviewLink(d) {
      return d.keys().hasAll(['orderId','merchantId','riderId','merchantName','riderName','createdAt','expiresAt','usedAt']) && d.keys().hasOnly(['orderId','merchantId','riderId','merchantName','riderName','createdAt','expiresAt','usedAt']) && text(d.orderId,128) && d.orderId.matches('^[A-Za-z0-9_-]+$') && text(d.merchantId,128) && text(d.riderId,128) && text(d.merchantName,100) && text(d.riderName,100) && d.createdAt == request.time && d.expiresAt is timestamp && d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(31,'d') && d.usedAt == null;
    }
    function deliveryReviewLinkOrder(d) {
      let order = get(/databases/$(database)/documents/orders/$(d.orderId)).data;
      return order.status == 'delivered' && order.creatorRole == 'merchant' && order.creatorId == d.merchantId && order.merchantId == d.merchantId && order.riderId == d.riderId;
    }
    function validDeliveryReview(d) {
      return d.keys().hasAll(['orderId','merchantId','riderId','riderRating','merchantRating','comment','reviewToken','createdAt']) && d.keys().hasOnly(['orderId','merchantId','riderId','riderRating','merchantRating','comment','reviewToken','createdAt']) && text(d.orderId,128) && text(d.merchantId,128) && text(d.riderId,128) && d.riderRating is int && d.riderRating >= 1 && d.riderRating <= 5 && d.merchantRating is int && d.merchantRating >= 1 && d.merchantRating <= 5 && optionalText(d.comment,1000) && d.reviewToken is string && d.reviewToken.matches('^[a-f0-9]{48}$') && d.createdAt == request.time;
    }
    function deliveryReviewMatchesLink(d) {
      let before = get(/databases/$(database)/documents/deliveryReviewLinks/$(d.reviewToken)).data;
      let after = getAfter(/databases/$(database)/documents/deliveryReviewLinks/$(d.reviewToken)).data;
      return before.usedAt == null && before.expiresAt > request.time && before.orderId == d.orderId && before.merchantId == d.merchantId && before.riderId == d.riderId && after.usedAt == request.time && deliveryReviewLinkOrder(before);
    }
    function deliveryReviewViewer(d) {
      return (hasRole('rider') && d.riderId == request.auth.uid) || (hasRole('merchant') && (self(d.merchantId) || storeMember(d.merchantId)));
    }
    match /deliveryReviewLinks/{token} {
      // The random token is the recipient's review capability; links cannot be listed.
      allow get: if token.matches('^[a-f0-9]{48}$');
      allow list: if false;
      allow create: if signedIn() && token.matches('^[a-f0-9]{48}$') && validDeliveryReviewLink(request.resource.data) && deliveryReviewLinkOrder(request.resource.data) && smsActor(request.resource.data) && getAfter(/databases/$(database)/documents/deliverySms/$(request.resource.data.orderId + '_delivered')).data.recipientReviewToken == token && getAfter(/databases/$(database)/documents/deliverySms/$(request.resource.data.orderId + '_delivered')).data.actorId == request.auth.uid && getAfter(/databases/$(database)/documents/deliverySms/$(request.resource.data.orderId + '_delivered')).data.status == 'submitting' && getAfter(/databases/$(database)/documents/deliverySms/$(request.resource.data.orderId + '_delivered')).data.createdAt == request.time;
      allow update: if resource.data.usedAt == null && resource.data.expiresAt > request.time && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedAt']) && request.resource.data.usedAt == request.time && getAfter(/databases/$(database)/documents/deliveryReviews/$(resource.data.orderId)).data.reviewToken == token && getAfter(/databases/$(database)/documents/deliveryReviews/$(resource.data.orderId)).data.createdAt == request.time;
      allow delete: if false;
    }
    match /deliveryReviews/{orderId} {
      allow get, list: if deliveryReviewViewer(resource.data);
      allow create: if orderId == request.resource.data.orderId && validDeliveryReview(request.resource.data) && deliveryReviewMatchesLink(request.resource.data);
      allow update, delete: if false;
    }
    match /users/{uid}/smsReads/{notificationId} {
      allow get, list: if self(uid) && active() && currentUser().role in ['customer','merchant'];
      allow create, update: if self(uid) && (smsCustomer(get(/databases/$(database)/documents/deliverySms/$(notificationId)).data) || smsMerchant(get(/databases/$(database)/documents/deliverySms/$(notificationId)).data)) && request.resource.data.keys().hasAll(['readAt']) && request.resource.data.keys().hasOnly(['readAt']) && request.resource.data.readAt == request.time;
      allow delete: if false;
    }
    match /deliverySms/{notificationId} {
      allow get: if signedIn() && (smsCustomer(resource.data) || smsMerchant(resource.data) || smsActor(resource.data));
      allow list: if isAdmin() || smsCustomer(resource.data) || smsMerchant(resource.data);
      allow create: if signedIn() && request.resource.data.keys().hasAll(['orderId','type','actorId','customerId','sender','message','status','errorCode','providerCode','campaignId','createdAt','updatedAt']) && request.resource.data.keys().hasOnly(['orderId','type','actorId','customerId','merchantId','recipientReviewToken','sender','message','status','errorCode','providerCode','campaignId','createdAt','updatedAt']) && text(request.resource.data.orderId,128) && request.resource.data.orderId.matches('^[A-Za-z0-9_-]+$') && request.resource.data.type in ['picked_up','delivered'] && notificationId == request.resource.data.orderId + '_' + request.resource.data.type && smsActor(request.resource.data) && smsAudienceMatchesOrder(request.resource.data) && smsReviewLink(request.resource.data) && request.resource.data.sender == 'KYE-TECH' && text(request.resource.data.message,1000) && request.resource.data.actorId == request.auth.uid && request.resource.data.status == 'submitting' && request.resource.data.errorCode == '' && request.resource.data.providerCode == '' && request.resource.data.campaignId == '' && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if signedIn() && smsActor(resource.data) && resource.data.status == 'submitting' && request.resource.data.status in ['submitted','failed','unknown'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','errorCode','providerCode','campaignId','updatedAt']) && optionalText(request.resource.data.errorCode,80) && optionalText(request.resource.data.providerCode,40) && optionalText(request.resource.data.campaignId,128) && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
