VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_USE_FIREBASE_EMULATORS=false
VITE_IMGBB_API_KEY=

# Server-only mNotify credential; excluded from Vite's browser environment.
VITE_MNOTIFY_API_KEY=
# Public website used in the completed-delivery rating SMS.
SMS_APP_URL=

# Server-only MojoAuth project API key for administrator email OTP (not an OIDC client secret).
MOJOAUTH_API_KEY=
# Server-only Firebase service-account JSON for privileged OTP storage and custom tokens.
# Alternatively configure Application Default Credentials with Firestore and token-signing permissions.
FIREBASE_SERVICE_ACCOUNT_JSON=
